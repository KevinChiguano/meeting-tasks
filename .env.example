# Configuración del servidor y base de datos (Supabase)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Configuración de Redis (BullMQ / Cache)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Gen AI (Gemini API)
GEMINI_API_KEY=your_gemini_api_key

# Configuración de Drizzle ORM (Conexión Directa PostgreSQL)
DATABASE_URL=postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres

